<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Google Play builds must target Android TV devices explicitly. Override
         the optional Leanback declaration inherited from main. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true"
        tools:replace="android:required" />

    <!-- Google Play builds must use Play's update mechanism. Remove the
         sideload-only package install permission inherited from main. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

</manifest>
