<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- One bundle serves every device: Leanback stays optional (inherited from
         main), so Play offers the build to phones, tablets and Android TV alike. -->

    <!-- Google Play builds must use Play's update mechanism. Remove the
         sideload-only package install permission inherited from main. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

</manifest>
